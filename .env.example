# Copy to .env for local dev only. In production inject from a secret manager.
AIBASE_ENV=local
AIBASE_LOG_LEVEL=INFO

# Providers: pick any registered adapter by name (see libs/aibase/providers/registry.py)
AIBASE_LLM__PROVIDER=fake
# Real LLM example (any OpenAI-format server): uncomment all three and set PROVIDER=openai_compat
# AIBASE_LLM__MODEL=my-model
# AIBASE_LLM__OPTIONS={"base_url":"http://localhost:8000/v1","api_key":"..."}
AIBASE_EMBEDDINGS__PROVIDER=fake
AIBASE_VECTORSTORE__PROVIDER=memory
AIBASE_STT__PROVIDER=fake
AIBASE_DIARIZATION__PROVIDER=fake
AIBASE_STORAGE__PROVIDER=local
AIBASE_STORAGE__OPTIONS={"root":"./data/storage"}
AIBASE_QUEUE__PROVIDER=memory
AIBASE_CACHE__PROVIDER=memory

# PHI: fail-closed by default. Never disable in production.
AIBASE_PHI__ENABLED=true
AIBASE_PHI__REDACTOR=regex
AIBASE_PHI__FAIL_CLOSED=true

# Auth (disabled only when ENV=local/test)
AIBASE_AUTH__ENABLED=false
# AIBASE_AUTH__ISSUER=https://idp.example.com
# AIBASE_AUTH__AUDIENCE=ai-api
# AIBASE_AUTH__PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AIBASE_AUTH__ALGORITHMS=["RS256"]

# Telemetry: any OTLP/HTTP endpoint (collector, Langfuse, Tempo, Datadog agent...)
# AIBASE_OTEL__ENDPOINT=http://localhost:4318/v1/traces
AIBASE_AUDIT__PATH=./data/audit/audit.jsonl
